<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#8CE5C2</item>
        <item name="android:navigationBarColor">#041813</item>
        <item name="android:statusBarColor">#041813</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#041813</item>
    </style>

    <style name="AppTheme.Launch" parent="AppTheme">
        <item name="android:windowBackground">@drawable/launch_screen</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

</resources>
