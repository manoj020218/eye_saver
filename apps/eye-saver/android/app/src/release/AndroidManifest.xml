<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The store build is fully on-device. React Native adds this permission
         transitively, so remove it explicitly for the release variant. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
</manifest>
