<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <queries>
    <package android:name="com.miui.securitycenter" />
    <package android:name="com.huawei.systemmanager" />
    <package android:name="com.coloros.safecenter" />
    <package android:name="com.oplus.safecenter" />
    <package android:name="com.vivo.permissionmanager" />
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>
  <application>
    <receiver
      android:name=".EyeSaverAdminReceiver"
      android:description="@string/eye_saver_admin_description"
      android:exported="true"
      android:label="@string/eye_saver_admin_label"
      android:permission="android.permission.BIND_DEVICE_ADMIN">
      <meta-data android:name="android.app.device_admin" android:resource="@xml/eye_saver_device_admin" />
      <intent-filter><action android:name="android.app.action.DEVICE_ADMIN_ENABLED" /></intent-filter>
    </receiver>
    <activity
      android:name=".BreakActivity"
      android:excludeFromRecents="true"
      android:exported="false"
      android:theme="@style/EyeSaverBreakTheme" />
    <service
      android:name=".BreakOverlayService"
      android:exported="false" />
    <service
      android:name=".RestrictedAppOverlayService"
      android:exported="false" />
    <service
      android:name=".RestrictedAppMonitorService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Parent-started selective app restriction during a child session" />
    </service>
    <service
      android:name=".TamperGuardService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Parent-enabled protection of settings and app installation during child mode" />
    </service>
    <receiver
      android:name=".BreakEnforcementReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="com.eyesaver.childsession.EVENT" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
